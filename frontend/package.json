{
  "name": "thinking-space-frontend",
  "private": true,
  "version": "2.9.3",
  "type": "module",
  "scripts": {
    "sync:excalidraw-fonts": "node scripts/syncExcalidrawFonts.mjs",
    "build:agent-cli": "node scripts/buildCapabilityRunnerBundle.mjs",
    "dev": "npm run sync:excalidraw-fonts && vite",
    "build": "npm run sync:excalidraw-fonts && vite build",
    "build:web": "npm run sync:excalidraw-fonts && tsc && vite build",
    "build:electron": "npm run sync:excalidraw-fonts && npm run build:agent-cli && BUILD_TARGET=electron vite build",
    "build:ios": "npm run sync:excalidraw-fonts && BUILD_TARGET=capacitor vite build && npx cap sync ios",
    "typecheck": "tsc --noEmit -p tsconfig.tests.json",
    "typecheck:src": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "electron:sync": "npm run build:electron && npx cap sync @capacitor-community/electron",
    "electron:dev": "npm run electron:sync && cd electron && npm run electron:start",
    "package:mac": "npm run electron:sync && cd electron && npm run electron:make:mac",
    "package:win": "npm run electron:sync && cd electron && npm run electron:make:win",
    "package:linux": "npm run electron:sync && cd electron && npm run electron:make:linux",
    "package:ios": "npm run build:ios && npx cap open ios",
    "agent:capabilities": "vite-node scripts/agent/capabilityRunner.ts",
    "agent:workspace:bootstrap": "vite-node scripts/agent/bootstrapAgentWorkspace.ts",
    "agent:workspace:restructure": "vite-node scripts/agent/restructureAgentWorkspace.ts",
    "lint": "eslint .",
    "preview": "vite preview",
    "prices:check": "node ../scripts/refresh-ai-prices.mjs --check",
    "prices:refresh": "node ../scripts/refresh-ai-prices.mjs --write",
    "prebuild": "npm run prices:sync",
    "prices:sync": "[ \"$PRICES_CHECK\" = \"off\" ] || node ../scripts/refresh-ai-prices.mjs --build",
    "prebuild:electron": "npm run prices:sync",
    "prebuild:ios": "npm run prices:sync",
    "prebuild:web": "npm run prices:sync"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.74.0",
    "@capacitor/browser": "^8.0.2",
    "@capacitor/cli": "^8.0.2",
    "@capacitor/core": "^8.0.2",
    "@capacitor/filesystem": "^8.1.0",
    "@capacitor/ios": "^8.1.0",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.1",
    "@codemirror/search": "^6.6.0",
    "@codemirror/state": "^6.5.4",
    "@codemirror/view": "^6.39.14",
    "@excalidraw/excalidraw": "^0.18.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-select": "^2.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.1.0",
    "@radix-ui/react-toolbar": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.12",
    "@uiw/react-codemirror": "^4.25.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "dexie": "^4.3.0",
    "feedsmith": "^2.9.0",
    "force-graph": "^1.51.4",
    "heic2any": "^0.0.4",
    "js-yaml": "^4.1.1",
    "katex": "^0.16.47",
    "lucide-react": "^0.468.0",
    "markdown-table": "^3.0.4",
    "openai": "^6.21.0",
    "pdfjs-dist": "^5.4.296",
    "react": "^18.3.1",
    "react-datasheet-grid": "^4.11.5",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-pdf": "^10.4.1",
    "react-router-dom": "^7.1.0",
    "recharts": "^3.8.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwind-merge": "^2.5.0",
    "thinking-orbs": "^0.3.1",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@capacitor-community/electron": "^5.0.1",
    "@eslint/compat": "^1.4.1",
    "@eslint/js": "^9.39.5",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/js-yaml": "^4.0.9",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "fake-indexeddb": "^6.2.5",
    "globals": "^15.15.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.67.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.8"
  },
  "author": "Anurag Patil"
}
